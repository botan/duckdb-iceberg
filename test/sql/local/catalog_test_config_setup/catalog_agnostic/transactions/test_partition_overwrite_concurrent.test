# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/transactions/test_partition_overwrite_concurrent.test
# description: Concurrent inserts replacing distinct partitions preserve every committed replacement
# group: [transactions]

require-env CATALOG_TEST_CONFIG_SETUP

# Only catalogs with verified atomic conflict detection can exercise simultaneous commits.
require-env ATOMIC_COMMIT_CONFLICT_SUPPORT

include test/sql/init_requires

statement ok
DROP TABLE IF EXISTS my_datalake.default.partition_overwrite_concurrent;

statement ok
CREATE TABLE my_datalake.default.partition_overwrite_concurrent (p INTEGER, id INTEGER)
PARTITIONED BY (p) WITH ('commit.retry.num-retries' = '12');

statement ok
INSERT INTO my_datalake.default.partition_overwrite_concurrent SELECT range, 0 FROM range(4);

concurrentloop i 0 4

statement ok
SET iceberg_insert_existing_partitions_behavior = 'overwrite';

statement ok
INSERT INTO my_datalake.default.partition_overwrite_concurrent VALUES ({i}, 100 + {i});

endloop

query II
SELECT p, id FROM my_datalake.default.partition_overwrite_concurrent ORDER BY p;
----
0	100
1	101
2	102
3	103

statement ok
DROP TABLE my_datalake.default.partition_overwrite_concurrent;
